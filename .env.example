# Copy this file to .env and fill in values.

# --- Database (required) ---
# 1. In pgAdmin create a database named: interview_ai
# 2. Put your postgres password below. Tables are created automatically on first start.
DATABASE_URL=postgresql+psycopg://postgres:capstone123@localhost:5432/interview_ai

# --- LLM (free) ---
# groq   -> get a free key at https://console.groq.com/keys
# gemini -> get a free key at https://aistudio.google.com/apikey
# ollama -> install https://ollama.com, run: ollama pull llama3.2
# none   -> disable LLM, use embedding + rule-based scoring only
LLM_PROVIDER=groq
LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# --- Speech ---
# tiny | base | small | medium  (bigger = more accurate, slower on CPU)
WHISPER_MODEL=small

# --- Worker ---
INLINE_WORKER=true
API_URL=http://localhost:8000
